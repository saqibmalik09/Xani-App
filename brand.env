# Canonical brand values for every client. Nothing user-visible is hardcoded in
# source; both platforms read these at build time.
#
# Android: exported as environment variables, or overridden per-build with
#          -PAPP_NAME=... (defaults live in android-client/gradle.properties)
# iOS:     mirrored in ios-client/Config/Brand.xcconfig
#
# Rebranding is these values plus one logo file per platform:
#   Android  app/src/main/java/.../ui/brand/BrandMark.kt
#   iOS      Sources/Brand/BrandMark.swift

# MaxLive brand (maxlive branch). merge=ours — never copy from omni.
APP_NAME=Maxlive
APP_WORDMARK=maxlive
APP_TAGLINE=

APP_ID=app.xani
IOS_BUNDLE_ID=app.xani

# Milliseconds the launch screen is held. Branding time is dead time, so keep it
# low; the contract forbids padding it to feel substantial.
SPLASH_MIN_MS=900

# Identity service. Must be https in any build that leaves a developer machine:
# the access token travels in an Authorization header on every request.
# Override per build with -PAPI_BASE_URL=... (Android) or an xcconfig edit (iOS).
API_BASE_URL=https://api.smilee.online

# Google Sign-In
# Android Credential Manager needs the WEB OAuth client id (audience the
# identity service verifies). iOS ASWebAuthenticationSession needs the iOS
# OAuth client id + its reverse-DNS URL scheme.
# Also set identity env GOOGLE_CLIENT_IDS to the Web client id.
# Never put the Web client *secret* in the apps — only the ids.
GOOGLE_WEB_CLIENT_ID=478634587205-js6vd3832ag5sdtkndi9b9cjt2ad6feg.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=478634587205-kj50e24sv6buu7m66jhprl6ca73hk1ao.apps.googleusercontent.com
# Android OAuth clients (package + SHA-1). Not used as ID-token audience.
GOOGLE_ANDROID_CLIENT_ID=478634587205-3ij5egmern9d58ch0qvmnqu0hlprd7tc.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID_RELEASE=478634587205-2vp4lkjsam09bqvuu2736bjudi028ahi.apps.googleusercontent.com
# Derived: com.googleusercontent.apps.<prefix-before-.apps.googleusercontent.com>
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.478634587205-kj50e24sv6buu7m66jhprl6ca73hk1ao
