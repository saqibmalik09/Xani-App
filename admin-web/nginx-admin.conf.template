# Xani admin console — SPA at admin.smilee.online
# Does NOT replace api / db / apex sites. Install via install-admin.sh.

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN_ADMIN;

    # Avatar uploads (raw image PUT). JSON bodies stay tiny on the service.
    client_max_body_size 8m;

    # Android App Links: Google fetches this on the *website* host (same host
    # as /join/…). Identity builds it from Settings → Branding.
    location = /.well-known/assetlinks.json {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8081;
    }

    # Same-origin API: the SPA calls /v1/* on this host; nginx forwards to identity.
    # Avoids browser CORS between admin.smilee.online and api.smilee.online.
    location /v1/ {
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass http://127.0.0.1:8081;
    }

    # Built Vite assets (hashed filenames) — long cache, immutable.
    location /assets/ {
        root DIST_ROOT;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    # SPA: every client route falls back to index.html.
    location / {
        root DIST_ROOT;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
